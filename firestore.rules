rules_version = '2';

// 각 사용자는 자기 데이터(users/{본인 uid}/...)만 읽고 쓸 수 있다.
// Firebase 콘솔 → Firestore → 규칙 에 이 내용을 붙여넣어 적용한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 노트
    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['title', 'body', 'created', 'updated', 'deleted', 'ink', 'tab', 'pinned'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 1000
        && request.resource.data.body is string && request.resource.data.body.size() <= 500000
        && request.resource.data.created is number
        && request.resource.data.updated is number
        && request.resource.data.deleted is bool
        // 펜 필기 · 글자 서식: 있을 때만, 글자로 저장
        && (!('ink' in request.resource.data)
          || (request.resource.data.ink is string && request.resource.data.ink.size() <= 400000))
        // AI 노트 주제 탭 id: 말씀 탭이면 없음
        && (!('tab' in request.resource.data)
          || (request.resource.data.tab is string && request.resource.data.tab.size() <= 100))
        // 목록 맨 위에 고정: 고정했을 때만
        && (!('pinned' in request.resource.data) || request.resource.data.pinned is bool);
    }

    // AI 노트 주제 탭 (이름 · 규칙과 참고 자료 · 용어 사전)
    match /users/{uid}/subjects/{subjectId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'rules', 'auto', 'dict', 'created', 'updated', 'deleted'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.rules is string && request.resource.data.rules.size() <= 20000
        && request.resource.data.dict is string && request.resource.data.dict.size() <= 250000
        && request.resource.data.auto is bool
        && request.resource.data.created is number
        && request.resource.data.updated is number
        && request.resource.data.deleted is bool;
    }
  }
}
