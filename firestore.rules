rules_version = '2';

// 각 사용자는 자기 메모(users/{본인 uid}/notes)만 읽고 쓸 수 있다.
// Firebase 콘솔 → Firestore → 규칙 에 이 내용을 붙여넣어 적용한다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/notes/{noteId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['title', 'body', 'created', 'updated', 'deleted', 'ink'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 1000
        && request.resource.data.body is string && request.resource.data.body.size() <= 500000
        && request.resource.data.created is number
        && request.resource.data.updated is number
        && request.resource.data.deleted is bool
        // 펜 필기: 있을 때만, 글자로 저장 (최대 약 40만 자)
        && (!('ink' in request.resource.data)
          || (request.resource.data.ink is string && request.resource.data.ink.size() <= 400000));
    }
  }
}
